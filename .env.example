# Luca Mali Müşavir giriş bilgileri (.env'e kopyala; .env asla commit edilmez)
# Giriş adresi: https://agiris.luca.com.tr/LUCASSO/giris.erp
LUCA_URL=https://agiris.luca.com.tr/LUCASSO/giris.erp
LUCA_MEMBER_NO=
LUCA_USERNAME=
LUCA_PASSWORD=

# 2FA kullanıyorsan (Authenticator 6 haneli kod). Boş bırakılırsa atlanır.
# Not: TOTP kodları kısa ömürlüdür; otomasyonda genelde LUCA_TOTP_SECRET tercih edilir.
LUCA_TOTP_CODE=
LUCA_TOTP_SECRET=

# TEST AŞAMASI: false bırak (tarayıcıyı görürsün). Cron/üretimde true yap.
LUCA_HEADLESS=false

# İzleme: yavaş hareket (ms). --watch kullanınca en az 250 uygulanır.
LUCA_SLOW_MO=300

# true = her kritik tıklamada terminalden [e/N] onayı iste (önerilir)
LUCA_CONFIRM_CRITICAL=true

# İsteğe bağlı kalıcı modlar (CLI --watch / --step / --dry-run ile de açılır)
LUCA_WATCH=false
LUCA_STEP=false
LUCA_DRY_RUN=false

# Zamanlayıcı: test bitene kadar BOŞ bırak. Örn. "0 9 * * 1-5" veya "every:3600"
LUCA_SCHEDULE=

# Hata olursa ekran görüntüsü kaydet
LUCA_SCREENSHOT_ON_ERROR=true
